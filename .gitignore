# ─── Unity 生成目录 ───
# Library / Temp / obj 都是可从 Assets + ProjectSettings + Packages 重新生成的产物
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/

# Assets 下的 .meta 必须提交——它存着资产 GUID，丢了会导致全项目引用断裂
!/[Aa]ssets/**/*.meta

# ─── IDE 自动生成的工程文件 ───
# Unity 每次导入都会按 asmdef 重新生成这些，提交了只会无谓冲突
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/
.consulo/

*.pidb.meta
*.pdb.meta
*.mdb.meta

# ─── 编辑器与工具 ───
/.idea/
/.vs/
/.vscode/
.DS_Store

# ─── 构建产物与崩溃报告 ───
*.apk
*.aab
*.app
*.unitypackage
sysinfo.txt
crashlytics-build.properties

# ─── Addressables ───
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ─── 导出的构建产物 ───
# 整个目录都是从工程重新生成的，一次构建 150MB+，不进版本库
/export/
